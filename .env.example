# ELITE WORKSHOP LTD — Monorepo environment reference (no secrets)
# Use client/.env.local and server/.env for local development.

# --- Frontend (client/.env.local) ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3020
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5010/api/v1

# --- Backend (server/.env) ---
# NODE_ENV=development
# PORT=5010
# CLIENT_URL=http://localhost:3020
# MONGODB_URI=mongodb://127.0.0.1:27017/elite_workshop_dev

# Local dev ports: website 3020, API 5010 (see client/package.json and server defaults).
