# ELITE WORKSHOP LTD — Next.js (copy to .env.local, do not commit)

NEXT_PUBLIC_SITE_URL=http://localhost:3020

# Public API base URL (includes /api/v1 prefix)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5010/api/v1

# Optional public contact fields — leave empty until owner provides official details
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_HOURS=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional social links (footer) — only shown when set
# NEXT_PUBLIC_SOCIAL_FACEBOOK=
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=

