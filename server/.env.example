# ELITE WORKSHOP LTD — Express API (copy to .env, do not commit)

NODE_ENV=development
PORT=5010

# Primary frontend origin for CORS (production must match the live site URL).
# In development, any http://localhost:<port> origin is also allowed if Next.js uses another port.
CLIENT_URL=http://localhost:3020

# Required for API startup (local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/elite_workshop_dev

# Optional rate limit tuning (defaults: 10 requests / 15 minutes per IP)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=10
